<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Placeholder geometry/inertia — see config/flex_inertials.yaml and
       docs/architecture/hardware_architecture.md (CAD-to-Sim Pipeline) -->
  <xacro:property name="base_x" value="0.18"/>
  <xacro:property name="base_y" value="0.12"/>
  <xacro:property name="base_z" value="0.30"/>
  <xacro:property name="base_mass" value="2.3"/>
  <xacro:property name="base_ground_clearance" value="0.122"/> <!-- wheel_radius + half wheel-axle drop, see flex_wheels.xacro -->

  <!-- base_footprint: standard ROS2 convention — ground-projected origin, no inertia -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_ground_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
      <material name="flex_chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.02001" iyy="0.02346" izz="0.00897" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
