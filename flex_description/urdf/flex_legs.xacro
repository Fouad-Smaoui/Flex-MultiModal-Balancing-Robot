<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Placeholder geometry/inertia — see config/flex_inertials.yaml.
       Models the servo-driven sit/stand leg-deploy mechanism
       (Images/FLEX_assis.png = sit, Images/FLEX_debout.png = stand)
       driven in firmware by servogauche/servodroit (firmware/src/main.cpp). -->
  <xacro:property name="leg_x" value="0.03"/>
  <xacro:property name="leg_y" value="0.03"/>
  <xacro:property name="leg_z" value="0.12"/>
  <xacro:property name="leg_mass" value="0.1"/>

  <!-- Revolute limits approximate the servo's calibrated sit/stand travel
       (servo*posbas / servo*poshaute in firmware/src/main.cpp) -->
  <xacro:property name="leg_lower_limit" value="-1.2"/>
  <xacro:property name="leg_upper_limit" value="0.2"/>
  <xacro:property name="leg_effort" value="2.0"/>
  <xacro:property name="leg_velocity" value="1.0"/>

  <xacro:macro name="flex_leg" params="side y_reflect">
    <link name="${side}_leg_link">
      <visual>
        <origin xyz="0 0 ${-leg_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_x} ${leg_y} ${leg_z}"/>
        </geometry>
        <material name="flex_leg_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-leg_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_x} ${leg_y} ${leg_z}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-leg_z/2}" rpy="0 0 0"/>
        <mass value="${leg_mass}"/>
        <inertia ixx="0.0001275" iyy="0.0001275" izz="0.000015" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${side}_leg_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${side}_leg_link"/>
      <origin xyz="0.05 ${y_reflect * 0.06} -0.12" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${leg_lower_limit}" upper="${leg_upper_limit}" effort="${leg_effort}" velocity="${leg_velocity}"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
  </xacro:macro>

  <xacro:flex_leg side="left" y_reflect="1"/>
  <xacro:flex_leg side="right" y_reflect="-1"/>

</robot>
