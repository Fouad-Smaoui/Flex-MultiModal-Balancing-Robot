<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control hardware interface declaration (Jazzy convention: declared directly in
       xacro rather than legacy <transmission> tags). "sim" here is filled in by
       gz_ros2_control's GazeboSimSystem plugin at launch; flex_hardware (future package)
       will offer "stm32"/"odrive" alternatives behind the same interface — see
       docs/architecture/simulation_architecture.md. -->
  <ros2_control name="flex_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_leg_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_leg_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- flex_control now exists (roadmap item #7) — load the controller_manager plugin. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find flex_control)/config/flex_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
