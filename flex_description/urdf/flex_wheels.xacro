<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Placeholder geometry/inertia — see config/flex_inertials.yaml -->
  <xacro:property name="wheel_radius" value="0.072"/>      <!-- Rroue, verified in firmware/src/main.cpp -->
  <xacro:property name="wheel_thickness" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="wheelbase" value="0.280"/>          <!-- verified in firmware/src/main.cpp rotationAngle calc -->
  <xacro:property name="wheel_z_offset" value="-0.05"/>     <!-- axle drop below base_link origin -->

  <xacro:macro name="flex_wheel" params="side y_reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
        <material name="flex_wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- iyy is the spin axis (joint axis is y) -->
        <inertia ixx="0.0002742" iyy="0.0005184" izz="0.0002742" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheelbase / 2} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.01"/>
    </joint>

    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:flex_wheel side="left" y_reflect="1"/>
  <xacro:flex_wheel side="right" y_reflect="-1"/>

</robot>
